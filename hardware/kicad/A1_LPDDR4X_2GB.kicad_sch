 (text "LPDDR4X 2GB baseline: Micron MT53E512M32D1ZW-046B WT:B, 16Gb x32, 200-ball TFBGA ZW." (at 30 20 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000500"))
(text "Single package, two x16 channels (A/B), single rank. 4266MT/s is the DRAM rating, not the board's selected operating rate." (at 30 30 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000501"))
(text "Micron ball map: 200 positions; 0.8mm column pitch, 0.65mm row pitch, Ø0.40mm SMD pads; A1 is upper-left in top view." (at 30 40 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000502"))
(text "Hidden power pins: VDD1=VCC1V8_DDR; VDD2=VCC_DDR_1V1; VDDQ=VCC0V6_DDR; VSS=GND." (at 30 50 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000503"))
(text "Single-rank NC: RK3568 CS1n_A/B, CKE1_A/B and ODT1_CA_A/B are not used; see SoC pin map." (at 30 60 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000504"))
(text "R40 = 240R ±1% from ZQ0 to VDDQ (0.60V), per Micron LPDDR4X datasheet." (at 300 250 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000505"))
(text "Release gate: confirm exact RK3568 PCB template + matching DDR BIN and validate land pattern before fabrication." (at 30 278 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "ab000000-0000-4000-8000-000000000506"))
