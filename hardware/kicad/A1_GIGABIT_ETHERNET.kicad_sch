(text "RGMII TX series resistors near SoC; RX series resistors near PHY; delay straps + Linux DTS must agree." (at 26 35 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "e2000000-0000-4000-8000-000000000002"))
(text "Do NOT reuse SDMMC1 for WLAN; this GMAC0 interface consumes SDMMC1 multiplexed balls." (at 26 44 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "e2000000-0000-4000-8000-000000000003"))
(text "Reset: GPIO0_D4 (PMUIO1 fixed 3.3V); assert low at least 10ms after supplies stable." (at 265 230 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "e2000000-0000-4000-8000-0000000000ac"))
(text "CFG_EXT=1, CFG_LDO[1:0]=10 -> external 1.8V PHY RGMII IO; check strapping interaction with LEDs." (at 265 288 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "e2000000-0000-4000-8000-0000000000bc"))
