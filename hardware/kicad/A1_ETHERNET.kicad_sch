 (no_connect (at 254.28 223.97) (uuid "b6000000-0000-4000-8000-00000000100f"))
 (text "ETHERNET — RK3568 GMAC0 / RTL8211F-CG / HR911130A" (at 35 32 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001150"))
(text "RGMII: VCCIO4=1.8V. PHY internal LDO configured to 1.8V: CFG_EXT=0, CFG_LDO[1:0]=10." (at 35 43 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001151"))
(text "PHY straps: address=1, PLLOFF=0, TXDLY=1, RXDLY=1. Linux: phy-mode=rgmii-id; no additional MAC delay." (at 35 52 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001152"))
(text "25MHz reference: RK3568 ETH0_REFCLKO_25M -> 22R -> PHY EXT_CLK; XTAL_IN grounded. CLKOUT unused." (at 35 61 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001153"))
(text "22R series: TXD[3:0]/TXEN/TXCLK and REFCLK/MDC/MDIO near RK3568; RXD[3:0]/RXDV/RXCLK near PHY." (at 35 70 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001154"))
(text "Reset: PHYRSTB low >=10ms; wait >=50ms after release before MDIO access. INTB open-drain pulled to 3V3." (at 35 79 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001155"))
(text "PHY 3V3 supply must support 1A steady-state; reserve this in the system 3V3 budget. EPAD pin41 to GND with thermal vias." (at 35 88 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001156"))
(text "HR911130A: pin11=LED1_K, pin12=LED1_A, pin13=LED2_K, pin14=LED2_A; P1=CT, P10 via 0R to GND." (at 35 97 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001157"))
(text "DMBJ 4x4 inductor footprint is provisional; verify against the current JLC EasyEDA land pattern before PCB release." (at 35 106 0) (effects (font (size 0.95 0.95)) (justify left)) (uuid "b6000000-0000-4000-8000-000000001158"))
